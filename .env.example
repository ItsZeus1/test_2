# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets — never prefix with NEXT_PUBLIC_, never commit real values
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by scripts/seed-admin.ts, run once locally/CI — never in client code
ADMIN_EMAIL=majd@elmadani.com
ADMIN_PASSWORD=set-your-own-strong-password-here
ADMIN_NAME=Majd
ADMIN_USERNAME=majd
