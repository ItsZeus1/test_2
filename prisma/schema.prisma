// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentMethod {
  CREDIT_CARD
  PAYPAL
  CRYPTO
  E_WALLET
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  password      String? // null for OAuth-only accounts
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)

  accounts     Account[]
  sessions     Session[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// --- NextAuth (Auth.js) required models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Domain models ---

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  publisher   String
  coverImage  String
  bannerImage String?
  isFeatured  Boolean  @default(false)

  // Dynamic fields this game needs from the player at checkout,
  // e.g. [{ "key": "playerId", "label": "Player ID" }, { "key": "serverId", "label": "Server ID" }]
  accountFields Json

  products     Product[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("games")
}

model Product {
  id          String  @id @default(cuid())
  gameId      String
  name        String // e.g. "500 Diamonds"
  amount      Int // in-game currency amount
  bonusAmount Int     @default(0)
  priceCents  Int // store money as integer cents
  currency    String  @default("USD")
  isPopular   Boolean @default(false)

  game         Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameId])
  @@map("products")
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  gameId        String
  productId     String
  status        TransactionStatus @default(PENDING)
  paymentMethod PaymentMethod

  // Player-supplied account info, e.g. { "playerId": "12345", "serverId": "Asia" }
  accountInfo Json

  totalCents Int
  currency   String @default("USD")

  providerReference String? // e.g. Stripe/PayPal session id

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  game    Game    @relation(fields: [gameId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("transactions")
}
